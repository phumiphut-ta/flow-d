<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 1. ป้องกันการเข้าถึงไฟล์ความลับสำคัญ เช่น .env, .git, artisan โดยตรง -->
                <rule name="Protect Sensitive Files" stopProcessing="true">
                    <match url="^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan|phpunit\.xml)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Direct access to this file is forbidden." />
                </rule>

                <!-- 2. หากเรียก Root Directory ว่างๆ ให้ส่งเข้า public/index.php -->
                <rule name="Rewrite Root to Public" stopProcessing="true">
                    <match url="^$" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>

                <!-- 3. Rewrite ทุก Request อื่นๆ ให้วิ่งเข้าโฟลเดอร์ public/ โดยอัตโนมัติ -->
                <rule name="Rewrite to Public Directory" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_URI}" pattern="^/public/" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>
            </rules>
        </rewrite>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>

